    {
      "line": 114,
      "text": "               \"sources\": [{\"path\": p.relative_to(ROOT).as_posix(), \"sha256\": digest(p)} for p in paths]}, exclusive=True)"
    },
    {
      "line": 122,
      "text": "    require(dr.date.is_unique and np.isfinite(dr.dr007.to_numpy(float)).all(), \"DR日期重复或数值缺失\")"
    },
    {
      "line": 127,
      "text": "    source = dr[[\"date\", \"dr007\"]].copy().sort_values(\"date\").reset_index(drop=True)"
    },
    {
      "line": 128,
      "text": "    source_dates = pd.DatetimeIndex(pd.to_datetime(source.date)).as_unit(\"ns\")"
    },
    {
      "line": 129,
      "text": "    available_indexes = np.searchsorted(dates.asi8, source_dates.asi8, side=\"right\")"
    },
    {
      "line": 131,
      "text": "    for day in source_dates:"
    },
    {
      "line": 143,
      "text": "    source[\"policy_known_at\"] = pd.to_datetime(policy_known, utc=True).tz_convert(\"Asia/Shanghai\")"
    },
    {
      "line": 144,
      "text": "    source[\"policy_effective_date\"] = pd.to_datetime(policy_effective)"
    },
    {
      "line": 145,
      "text": "    source[\"policy_rate_percent\"] = rates"
    },
    {
      "line": 146,
      "text": "    source[\"gap_pp\"] = source.dr007 - source.policy_rate_percent"
    },
    {
      "line": 149,
      "text": "    source[\"available_at\"] = pd.to_datetime(available, utc=True).tz_convert(\"Asia/Shanghai\")"
    },
    {
      "line": 150,
      "text": "    source[\"is_original_stock_session\"] = source_dates.isin(dates)"
    },
    {
      "line": 151,
      "text": "    by_date = source.set_index(\"date\")"
    },
    {
      "line": 154,
      "text": "    daily[\"dr007\"] = by_date.dr007.reindex(dates).to_numpy(float)"
    },
    {
      "line": 170,
      "text": "    return daily, source"
    },
    {
      "line": 187,
      "text": "    market = pd.read_parquet(CURRENT / \"inputs/candidate_features.parquet\", columns=[\"date\", \"symbol\"])"
    },
    {
      "line": 188,
      "text": "    dr = pd.read_parquet(DR)"
    },
    {
      "line": 189,
      "text": "    required = {\"ts_code\": \"DR007.IB\", \"repo_maturity\": \"DR007\", \"provider_value_field\": \"weight\","
    },
    {
      "line": 190,
      "text": "                \"value_semantics\": \"WEIGHTED_AVERAGE_RATE_PERCENT\", \"source_identity\": \"TUSHARE_PRO_REPO_DAILY_DR007_IB\","
    },
    {
      "line": 194,
      "text": "    manifest = read(DR_ROOT / \"dr007_tushare_source_acquisition_manifest.json\")"
    },
    {
      "line": 196,
      "text": "    acquisition = read(POLICY_ROOT / \"pboc_source_acquisition_manifest.json\")"
