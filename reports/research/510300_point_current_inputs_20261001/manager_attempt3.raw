                date: profitDate,
                data: fenhongData
            });

        // 走势图渲染
        if((container == 'fund-echarts-dwjz' || container == 'fund-echarts-ljjz') && profitDateArr.length > 0){
            queryChart('510300','', oldDate, currDate, '9496d23c648f4a72a79150c3f2ac669b', container, legendAll,"0",0,profitDateArr);
        }else {
            queryChart('510300','', oldDate, currDate, '9496d23c648f4a72a79150c3f2ac669b', container, legendAll,"0",0);
        }
    }

