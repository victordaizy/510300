    "recombination": 0.7,
    "tol": 0.000001,
    "atol": 0.00000001,
    "polish": false,
    "updating": "deferred",
    "vectorized": true,
    "workers": 1,
    "seed": 20260905,
    "seed_rule": "seed + training_end_year; FULL与SIMPLE及九组配置共用该规则",
